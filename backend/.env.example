# Copy this file to .env and fill in real values. NEVER commit .env.

# ---------- LLM ----------
# Which provider to use: claude | gemini | openai | ollama | fake
LLM_PROVIDER=claude

# Model for the active provider. For Claude, prefer haiku during dev (cheap).
LLM_MODEL=claude-haiku-4-5

# Anthropic API key (required if LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=

# Google Gemini API key (required if LLM_PROVIDER=gemini)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenAI API key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=

# Ollama base URL (only if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# ---------- Triple store ----------
# EvdoGraph GraphDB endpoint (read-only)
GRAPHDB_ENDPOINT=http://lod.csd.auth.gr:7200/repositories/Evdoxus
GRAPHDB_READONLY=true

# ---------- App ----------
LOG_LEVEL=INFO
# Where to cache LLM responses during development (disk)
LLM_CACHE_DIR=.llm_cache
# Disable the cache for a run by setting this to 1
LLM_CACHE_DISABLED=0

# CORS origin for the frontend (Vite default)
FRONTEND_ORIGIN=http://localhost:5173
