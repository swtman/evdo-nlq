# =============================================================================
# evdograph-nlq — environment configuration
#
# Docker Compose:  cp .env.example .env  (at repo root, then edit)
# Native dev:      cp .env.example backend/.env  (then edit)
# =============================================================================

# LLM provider: claude | gemini | ollama | fake
LLM_PROVIDER=claude
LLM_MODEL=claude-haiku-4-5

# --- Cloud keys (only the key for your chosen provider is required) ----------
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- Local LLM (only needed if LLM_PROVIDER=ollama or --profile ollama) ------
# In Docker Compose: leave as-is — compose overrides to http://ollama:11434
# Native dev with local Ollama: leave as-is — http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# --- GraphDB -----------------------------------------------------------------
# Default is the AUTh public endpoint. Change only if running a local instance.
GRAPHDB_ENDPOINT=http://lod.csd.auth.gr:7200/repositories/EvdoGraph

# --- Backend -----------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
LOG_LEVEL=INFO
LLM_CACHE_DIR=.llm_cache
LLM_CACHE_DISABLED=0
# Set to 0 to disable pre-LLM entity/alias resolution and Greek stemming hints.
# Useful for A/B comparison: run eval with GROUNDING_ENABLED=0 to get a v4-style baseline.
GROUNDING_ENABLED=1
# Resolve multi-word course/book names to exact KG titles before falling
# back to stem-CONTAINS hints (see title_index.py, ADR-018/ADR-019).
# Each corpus has its own on/off switch and match threshold (0..1, rapidfuzz
# token_sort_ratio similarity) so they can be tuned or disabled independently.
COURSE_LINKING_ENABLED=1
COURSE_MATCH_THRESHOLD=0.7
BOOK_LINKING_ENABLED=1
BOOK_MATCH_THRESHOLD=0.7
